<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.FatherOfApps" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item> <!-- Ẩn ActionBar -->
        <item name="windowNoTitle">true</item> <!-- Ẩn tiêu đề của cửa sổ -->
        <item name="android:windowFullscreen">true</item> <!-- Đảm bảo ứng dụng ở chế độ toàn màn hình -->
        <item name="colorPrimary">@color/color_main</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primaryLightColor</item>
        <item name="colorSecondaryVariant">@color/primaryDarkColor</item>
        <item name="colorOnSecondary">#c53a00</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.FatherOfApps.Splash">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/blue_main</item>
        <item name="android:windowFullscreen">true</item> <!-- Đảm bảo ứng dụng ở chế độ toàn màn hình -->
    </style>

    <!-- Fullscreen Dialog -->
    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
