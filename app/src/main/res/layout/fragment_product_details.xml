<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.fatherofapps.androidbase.ui.details.ProductDetailsViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Carousel RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCarousel"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager"/>

            <!-- Below Contact Button: Added ConstraintLayout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp">

                <!-- Title of the page -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@{viewModel.promotionalPost.data.title}"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Price per square meter -->
                <TextView
                    android:id="@+id/tvPricePerMeter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="108,57 triệu/m²"
                    android:textColor="#FF0000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@+id/llPropertyDetails"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <!-- Property Details -->
                <LinearLayout
                    android:id="@+id/llPropertyDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:elevation="@dimen/cardview_default_radius"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="@+id/glFeatures"
                    app:layout_constraintStart_toStartOf="@+id/tvFeaturesTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvPricePerMeter">

                    <!-- Address -->
                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.promotionalPost.data.description}"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <!-- Logo cho vị trí -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/icon_loaction"
                            android:layout_marginRight="4dp" /> <!-- Khoảng cách giữa icon và text -->

                        <!-- Địa chỉ -->
                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quận"
                            android:textColor="#000000"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{`Giá: ${viewModel.promotionalPost.data.pricingDetails.basePrice} VNĐ`}"
                        android:textColor="#FF0000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Time -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_timer"
                        android:layout_marginRight="4dp"/>

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 phút trước"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>
                </LinearLayout>

                <!-- Title for Features -->
                <TextView
                    android:id="@+id/tvFeaturesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Đặc điểm phòng"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/glFeatures"
                    app:layout_constraintTop_toBottomOf="@+id/llPropertyDetails" />

                <!-- Real Estate Features -->
                <GridLayout
                    android:id="@+id/glFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:elevation="@dimen/cardview_default_radius"
                    android:background="@drawable/rounded_background"
                    android:columnCount="2"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvFeaturesTitle">

                    <!-- Number of Bedrooms -->


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_floor"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_Floor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:text="@{`Tầng: ${viewModel.promotionalPost.data.roomInfo.floor}`}"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Number of Bathrooms -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bed"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_numberOfBedrooms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số phòng ngủ: 2"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Area -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_area"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_TotalArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diện tích: 70 m²"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Number of Bathrooms -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bath"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_numberOfBathrooms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số phòng tắm: 2"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Width Room -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_height"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_widthRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Chiều rộng: 2"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Capacity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_capacity"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Dung tích: 2"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_width"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_HeightRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Chiều dài: 2"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_status"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Trạng thái: Hoạt động"
                            android:textColor="@color/black"
                            android:layout_marginBottom="3dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                </GridLayout>


                <TextView
                    android:id="@+id/tvServiceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặc điểm dịch vụ"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/glFeatures"
                    app:layout_constraintTop_toBottomOf="@+id/glFeatures" />


                <!-- Contact options -->

                <!-- Contact options -->

                <!-- Room Utilities -->


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
