<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.fatherofapps.androidbase.ui.details.ProductDetailsViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Carousel RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCarousel"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager"/>

            <!-- Below Contact Button: Added ConstraintLayout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp">

                <!-- Title of the page -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhà rộng đẹp thật đấy anh em ạ"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Price per square meter -->
                <TextView
                    android:id="@+id/tvPricePerMeter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="108,57 triệu/m²"
                    android:textAllCaps="true"
                    android:textColor="@color/color_main"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/llPropertyDetails"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <!-- Property Details -->
                <LinearLayout
                    android:id="@+id/llPropertyDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:elevation="@dimen/cardview_default_radius"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPricePerMeter">

                    <!-- Address -->
                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@{viewModel.promotionalPost.description}"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Logo cho vị trí -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/icon_loaction" /> <!-- Khoảng cách giữa icon và text -->

                        <!-- Địa chỉ -->
                        <TextView
                            android:id="@+id/tvAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Quận"
                            android:textColor="#000000"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@{`Giá: ${viewModel.promotionalPost.pricingDetails.basePrice} VNĐ`}"
                        android:textColor="#FF0000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Time -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/icon_timer" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="3 phút trước"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Title for Features -->

                <View
                    android:id="@+id/divider3"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/g_gray700"
                    android:backgroundTint="@color/g_blue_gray200"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llPropertyDetails" />

                <TextView
                    android:id="@+id/tvFeaturesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặc điểm phòng"
                    android:textColor="@color/color_main"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/glFeatures"
                    app:layout_constraintTop_toBottomOf="@+id/divider3" />

                <!-- Real Estate Features -->
                <GridLayout
                    android:id="@+id/glFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:elevation="@dimen/cardview_default_radius"
                    android:background="@drawable/rounded_background"
                    android:columnCount="2"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvFeaturesTitle">

                    <!-- Number of Bedrooms -->


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_floor"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_Floor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@{`Tầng: ${viewModel.promotionalPost.roomInfo.floor}`}"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Number of Bathrooms -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bed"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_numberOfBedrooms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số phòng ngủ: 2"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Area -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_area"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_TotalArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diện tích: 70 m²"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Number of Bathrooms -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bath"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/txt_numberOfBathrooms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số phòng tắm: 2"
                            android:fontFamily="@font/roboto_regular"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Width Room -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_height"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_widthRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Chiều rộng: 2"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Capacity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:textSize="14sp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_capacity"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Dung tích: 2"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!--  Width Room-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_width"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_HeightRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Chiều dài: 2"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginBottom="3dp"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_status"
                            android:layout_marginRight="4dp" />


                        <TextView
                            android:id="@+id/txt_Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Trạng thái: Hoạt động"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_regular"
                            android:layout_marginBottom="3dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                </GridLayout>


                <!-- Furniture and Amenities Section -->
                <TextView
                    android:id="@+id/tvRoomUtilityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiện ích trong phòng"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_main"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/glFeatures"
                    app:layout_constraintTop_toBottomOf="@+id/glFeatures" />

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/rounded_background"
                    android:elevation="@dimen/cardview_default_radius"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tvRoomUtilityTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvRoomUtilityTitle">

                    <TextView
                        android:id="@+id/tvFurnitureAvailability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="start"
                        android:paddingStart="20dp"
                        android:text="Nội thất:"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvAmenitiesAvailability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="start"
                        android:text="Tiện nghi:"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detailed_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả chi tiết"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/linearLayout"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

                <LinearLayout
                    android:id="@+id/linearLayoutDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_background"
                    android:elevation="@dimen/cardview_default_radius"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:paddingBottom="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/linearLayout"
                    app:layout_constraintStart_toStartOf="@+id/linearLayout"
                    app:layout_constraintTop_toBottomOf="@+id/tv_detailed_description">

                    <TextView
                        android:id="@+id/txt_detailed_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPhoneNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liên hệ: 0123456789"
                        android:textColor="@color/black"
                        android:textStyle="italic"
                        android:autoLink="phone" />
                    <View
                        android:id="@+id/divider1"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/g_gray700"
                        android:backgroundTint="@color/g_blue_gray200"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/btnToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:textColor="@color/color_main"
                        android:text="Xem thêm"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_amenities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá dịch vụ"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/linearLayoutDetails"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayoutDetails" />

                <GridLayout
                    android:id="@+id/glCharacteristic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/rounded_background"
                    android:columnCount="2"
                    android:elevation="@dimen/cardview_default_radius"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_amenities">

                    <!-- Number of Bedrooms -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/ic_electric" />

                        <TextView
                            android:id="@+id/txt_electricMoney"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginBottom="3dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Giá điện: 60 VNĐ / Kwh"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginBottom="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/ic_shower" />

                        <TextView
                            android:id="@+id/txt_WaterMoney"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Giá nước: 40 VNĐ / m³"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Furniture Availability TextView spanning both columns -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAvailability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnSpan="2"
                        android:layout_columnWeight="2"
                        android:gravity="center"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:overScrollMode="never"
                        tools:listitem="@layout/item_additional_fee" />
                </GridLayout>
                <!-- Price Breakdown Pie Chart Section -->
                <TextView
                    android:id="@+id/tv_price_breakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phân tích chi phí"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/glCharacteristic"
                    app:layout_constraintTop_toBottomOf="@+id/glCharacteristic" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="0dp"
                    android:layout_height="300dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/rounded_background"
                    android:elevation="@dimen/cardview_default_radius"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_price_breakdown" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</layout>
