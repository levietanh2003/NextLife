<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề biểu đồ giá trung bình -->
        <TextView
            android:id="@+id/titleBarChartText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biểu đồ giá trung bình theo khu vực"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <!-- Stacked Bar Chart -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="400dp"/>

        <!-- Tiêu đề biểu đồ loại phòng -->
        <TextView
            android:id="@+id/titlePieChartText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thống kê loại phòng"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

        <!-- Pie Chart -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChartRoomTypes"
            android:layout_width="match_parent"
            android:layout_height="350dp"/>
    </LinearLayout>
</ScrollView>