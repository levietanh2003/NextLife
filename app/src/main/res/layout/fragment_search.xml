<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Khai báo ViewModel -->
        <variable
            name="viewModel"
            type="com.fatherofapps.androidbase.ui.search.SearchViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Phần chứa icon vị trí và dropdown khoảng cách -->
            <LinearLayout
                android:id="@+id/btn_filter_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Icon Vị trí -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_loaction" />

                <!-- Địa điểm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_regular"
                    android:maxLines="1"
                    android:text="Tiếm kiếm theo định vị của bạn.....               "
                    android:textColor="#757575"
                    android:textSize="14sp" />

                <!-- Dropdown khoảng cách -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center_vertical"
                    android:text="10km"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Phần chứa thanh lọc, danh mục và giá -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Thanh lọc -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <!-- Icon bộ lọc -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_filter" />

                    <!-- Text Lọc -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="Lọc"
                        android:textColor="@color/color_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Đường thẳng dọc -->

                </LinearLayout>

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/darker_gray" />

                <!-- Dropdown danh mục -->
                <TextView
                    android:id="@+id/spinner_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:text="Danh mục"
                    android:textColor="@android:color/black" />

                <!-- Dropdown giá -->
                <TextView
                    android:id="@+id/spinner_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:text="Giá"
                    android:textColor="@color/black" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
