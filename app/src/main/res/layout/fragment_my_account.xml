<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar cố định ở trên -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_main"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tài khoản"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Nội dung cuộn được đặt dưới Toolbar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">

            <!-- Nội dung bên trong -->
            <LinearLayout
                android:id="@+id/linear_layout_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_avartar" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:src="@drawable/ic_edit" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dân chơi vip"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RatingBar
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Chưa có đánh giá)"
                        android:textColor="#666666" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Người theo dõi • 5 Người đang theo dõi" />
                </LinearLayout>
            </LinearLayout>

            <!-- Account ID Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/id_user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TK Định danh: C0888226846210" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sao chép"
                    android:textColor="#2196F3" />
            </LinearLayout>
            <!-- Menu Items -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Quản lý đơn hàng"
                android:textColor="@color/color_main"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_shopping_bag"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Đơn mua"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sell"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Đơn bán"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/btnHistoryPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_wallet"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Ví cá nhân"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!--         Tien ich-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="Tiện ích"
                android:textColor="@color/color_main"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_favorite"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Tin đã lưu"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_save_search"
                    android:drawablePadding="16dp"
                    android:padding="12dp"
                    android:text="Tìm kiếm đã lưu"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_wallet"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Đánh giá từ tôi"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!--  Khác-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="Khác"
                android:textColor="@color/color_main"
                android:textStyle="bold" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_setting"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Cài đặt tài khoản"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_manager_password"
                    android:drawablePadding="16dp"
                    android:padding="12dp"
                    android:text="Quản lý dăng nhập"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/linear_layout_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:drawableStart="@drawable/ic_logout"
                    android:drawablePadding="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="12dp"
                    android:text="Đăng xuất"
                    android:textColor="@color/black" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/roboto_regular"
                    android:text="NextLife phiên bản: 1.0.0"
                    android:textSize="10sp" />
            </LinearLayout>
            <!-- Thêm các phần khác trong ScrollView -->
            <!-- Các phần "Account ID Section", "Points Section", "Menu Items" và các phần còn lại -->

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
